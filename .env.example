# Copy to .env and fill in. Never commit .env.

# Database
DB_USERNAME=psar
DB_PASSWORD=psar

# Security (at least 32 bytes; generate with: openssl rand -base64 48)
JWT_SECRET=

# File storage - Cloudinary (console -> API Keys): cloudinary://<api-key>:<api-secret>@<cloud-name>
CLOUDINARY_URL=
# Root folder in Cloudinary (default psar-dev locally, psar in production)
STORAGE_FOLDER=

# RabbitMQ (Phase 9)
RABBITMQ_USERNAME=psar
RABBITMQ_PASSWORD=psar

# Payments - KHQR / Bakong (Phase 5)
# Your Bakong account id (e.g. name@bank) shown in every KHQR code
KHQR_MERCHANT_ID=
# fake = payments only "arrive" through the simulate endpoint (dev); bakong = ask the real Bakong Open API
BAKONG_MODE=fake
BAKONG_API_TOKEN=
# Shared secret for signed payment webhooks (openssl rand -hex 32)
PAYMENT_WEBHOOK_SECRET=

# Telegram bot (Phase 9)
TELEGRAM_BOT_TOKEN=

# AI - Gemini (Phase 11)
GEMINI_API_KEY=
