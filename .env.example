# Copy to .env and fill in. Never commit .env.

# Database
DB_USERNAME=psar
DB_PASSWORD=psar

# Security (at least 32 bytes; generate with: openssl rand -base64 48)
JWT_SECRET=

# Storage (MinIO locally, S3/R2 in production)
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# RabbitMQ (Phase 9)
RABBITMQ_USERNAME=psar
RABBITMQ_PASSWORD=psar

# Payments - KHQR / Bakong sandbox (Phase 5)
KHQR_MERCHANT_ID=
BAKONG_API_TOKEN=

# Telegram bot (Phase 9)
TELEGRAM_BOT_TOKEN=

# AI - Gemini (Phase 11)
GEMINI_API_KEY=
